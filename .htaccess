# pda-tue.nl (Plesk). The whole repo is the web root, so hide what visitors never need.
# Only deploy-hook.php may run PHP.
<FilesMatch "\.(py|md|yml|yaml|pyc|txt|sh)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<Files "deploy-hook.php">
    Require all granted
</Files>
RedirectMatch 404 ^/(tools|\.github)(/|$)

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
